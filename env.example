ANTHROPIC_API_KEY=
LINKEDIN_TOKEN=
# urn:li:person:XXXX for a profile, urn:li:organization:XXXX for a company page
LINKEDIN_AUTHOR_URN=
# Optional
DEFAULT_HEADLINE=
BASE_IMAGE=assets/base.png

# Gemini (Google AI Studio) - image generation. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Image model chain (must support image output). Models are tried in order and
# the next is used if one fails. Comma-separate to override the default list:
# gemini-3.8-flash,gemini-3-flash-preview,gemini-3.1-flash-lite-preview
# If every model fails, the app falls back to the base.png overlay instead of
# blocking the post.
GEMINI_IMAGE_MODEL=

# Gmail reader (linkedin-post-bot@decirclesolar.com) - create an OAuth web app
# client at https://console.cloud.google.com/apis/credentials and enable the
# Gmail API. Scope used: gmail.readonly. Run /gmail/login once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/gmail/callback
# Printed once by /gmail/callback after you approve access.
GOOGLE_GMAIL_REFRESH_TOKEN=
# Gmail search query for which messages to read. Defaults to the bot address alias, unread.
GMAIL_QUERY=
# How often the app checks the inbox automatically (milliseconds). Default 3600000 (hourly).
GMAIL_POLL_INTERVAL_MS=3600000
# Set to "false" to disable the automatic poller (manual /check-gmail still works).
GMAIL_ENABLED=true
# Image for email-derived posts on approval: sharp (base.png overlay, no tokens),
# gemini (full infographic via Gemini), or none (text-only post).
EMAIL_POST_IMAGE_MODE=sharp

# LinkedIn newsletter digest - scrapes our own profile's recent posts with an
# Apify actor, writes ONE weekly digest post with Gemini, and queues it as a
# pending draft (approval still required before it is published).
# Apify token: https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Profile (or company) page whose posts are digested.
LINKEDIN_PROFILE_URL=
# Actor used for scraping. Its input must accept targetUrls/maxPosts/postedLimitDate.
APIFY_ACTOR_ID=harvestapi/linkedin-profile-posts
# Gemini text model used to write the digest.
NEWSLETTER_MODEL=gemini-3.1-flash-lite-preview
# Set to "false" to disable the weekly timer (the dashboard button still works).
NEWSLETTER_ENABLED=true
# Weekly run time, local. NEWSLETTER_DAY: 0=Sunday ... 6=Saturday. Default Monday 09:00.
NEWSLETTER_DAY=1
NEWSLETTER_HOUR=9
# How many days of posts the digest covers. Default 6.
NEWSLETTER_LOOKBACK_DAYS=6
# Max posts fetched from Apify per run. Default 30.
NEWSLETTER_MAX_POSTS=30

# URL shortener for the "Read more:" links in the digest. Comma-separated list
# tried in order; "none" disables it (the digest then uses LinkedIn's canonical
# permalink). Free, no API key. If every provider fails the permalink is used.
URL_SHORTENER=is.gd,tinyurl
# Per-request timeout (ms) for a shortener call. Default 5000.
URL_SHORTENER_TIMEOUT_MS=5000
# Minimum spacing between shortener calls (ms). is.gd allows ~5 requests/10s.
# Default 2200.
URL_SHORTENER_MIN_INTERVAL_MS=2200
