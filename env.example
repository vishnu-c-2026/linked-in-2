ANTHROPIC_API_KEY=
LINKEDIN_TOKEN=
# urn:li:person:XXXX for a profile, urn:li:organization:XXXX for a company page
LINKEDIN_AUTHOR_URN=
# Optional
DEFAULT_HEADLINE=
BASE_IMAGE=base.png

# Google Sheets (Newsletter tab) - create an OAuth web app client at
# https://console.cloud.google.com/apis/credentials and enable the Sheets API.
# Scope used: spreadsheets.readonly (the sheet is never modified).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/google/callback
# Printed once by /google/callback after you approve access.
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
# Tab to read (0 is the first tab in the sheet).
GOOGLE_SHEET_GID=0
